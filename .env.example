# New Eden Foundry — Beispielkonfiguration
#
# Kopieren nach .env. Diese Datei enthaelt bewusst KEINE Geheimnisse:
# der native SSO-Flow (Kapitel 4) arbeitet mit PKCE und braucht kein Client Secret.
# Der Refresh Token liegt im Schluesselbund des Systems, nie in einer Datei.

# ---------------------------------------------------------------------------
# EVE SSO — Anwendung im Developers-Portal als Typ "native" registrieren.
# Die Client-ID ist oeffentlich; sie darf im Repo stehen und in der Anwendung
# ausgeliefert werden. Ein Client Secret gibt es fuer native Anwendungen nicht.
# ---------------------------------------------------------------------------
FOUNDRY_ESI_CLIENT_ID=

# Callback exakt so im Developers-Portal eintragen. Fester Port: die SSO weist
# jede abweichende URL zurueck.
FOUNDRY_SSO_CALLBACK_PORT=8765

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Nur die Loopback-Adresse. Ein Bind auf 0.0.0.0 macht die Anwendung fuer das
# ganze Netz erreichbar und ist hier immer ein Fehler.
FOUNDRY_HOST=127.0.0.1
FOUNDRY_PORT=8000

# Sitzungsgeheimnis. Im Normalbetrieb erzeugt die Tauri-Schale es beim Start und
# reicht es dem Sidecar durch. Nur fuer den Entwicklungsbetrieb ohne Schale
# haendisch setzen -- leer bedeutet: das Backend erzeugt eins und schreibt es in
# das Datenverzeichnis, damit `npm run dev` es lesen kann.
FOUNDRY_SESSION_SECRET=

# Datenverzeichnis. Leer = plattformueblicher Pfad (siehe docs/runbook.md).
FOUNDRY_DATA_DIR=

# ---------------------------------------------------------------------------
# ESI
# ---------------------------------------------------------------------------
# Kontaktadresse im User-Agent. Pflicht, nicht Hoeflichkeit (Kapitel 6).
FOUNDRY_CONTACT_EMAIL=

# Log-Stufe: DEBUG, INFO, WARNING, ERROR
FOUNDRY_LOG_LEVEL=INFO
