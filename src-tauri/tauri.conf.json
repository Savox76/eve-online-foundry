{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "New Eden Foundry",
  "version": "0.2.0",
  "identifier": "de.savox76.neweden-foundry",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "New Eden Foundry",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://images.evetech.net; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:8000",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [
      "binaries/foundry-backend"
    ],
    "shortDescription": "Industrie-Werkzeug fuer EVE Online",
    "longDescription": "Bestaende, Blueprints, Produktionsketten, T2 Invention, Marktscanner und planetare Industrie -- als eigenstaendige Anwendung mit EVE-SSO-Login.",
    "copyright": "EVE Online und alle zugehoerigen Marken sind Eigentum von CCP hf."
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/Savox76/eve-online-foundry/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "HIER-DEN-OEFFENTLICHEN-SCHLUESSEL-AUS-`npx tauri signer generate`-EINSETZEN"
    }
  }
}
